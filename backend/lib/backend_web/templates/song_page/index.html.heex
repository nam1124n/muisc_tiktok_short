<div class="page-shell">
  <section class="hero dashboard-hero">
    <div class="hero-actions">
      <div class="hero-copy">
        <h1>AI Generation Dashboard</h1>
        <p>
          Trang tổng quan dành riêng cho chức năng tạo nhạc bằng AI: xem nhanh số lượng
          bài đã generate, trạng thái xử lý và đi sang màn hình quản lý danh sách đã tạo.
        </p>
      </div>

      <div class="button-row">
        <a class="secondary-button hero-button" href={~p"/songs/library"}>
          Xem user + bài hát
        </a>
      </div>
    </div>

    <div class="toolbar">
      <span class="chip">Dashboard: <strong>&nbsp;/songs</strong></span>
      <span class="chip">Quản lý thư viện: <strong>&nbsp;/songs/library</strong></span>
      <span class="chip">Nguồn dữ liệu hiện tại: <strong>&nbsp;<%= @data_source_label %></strong></span>
    </div>
  </section>

  <section class="stat-grid stat-grid-wide">
    <article class="card stat-card">
      <div class="stat-label">Total Songs</div>
      <div class="stat-value">{@overall_stats.total}</div>
    </article>

    <article class="card stat-card">
      <div class="stat-label">Total Users</div>
      <div class="stat-value">{@overall_stats.users}</div>
    </article>

    <article class="card stat-card">
      <div class="stat-label">Processing</div>
      <div class="stat-value">{@overall_stats.processing}</div>
    </article>

    <article class="card stat-card">
      <div class="stat-label">Completed</div>
      <div class="stat-value">{@overall_stats.completed}</div>
    </article>
  </section>

  <section class="dashboard-grid">
    <article class="card dashboard-panel">
      <div class="section-head">
        <div class="section-copy">
          <h2>Điều hướng nhanh</h2>
          <p class="muted">
            Tách rõ dashboard và màn hình quản lý để bố cục đỡ rối và thao tác nhanh hơn.
          </p>
        </div>
      </div>

      <div class="quick-grid">
        <a class="quick-card" href={~p"/songs/library"}>
          <div class="quick-card-kicker">Library</div>
          <h3>User + bài hát</h3>
          <p>
            Xem danh sách user, các bài đã tạo, lọc theo trạng thái và đi tiếp sang sửa/xóa.
          </p>
        </a>
      </div>
    </article>

    <article class="card dashboard-panel">
      <div class="section-head">
        <div class="section-copy">
          <h2>User nổi bật</h2>
          <p class="muted">Các user có nhiều bài hát nhất hiện tại.</p>
        </div>
      </div>

      <%= if Enum.empty?(@top_users) do %>
        <div class="empty-state">
          Chưa có user nào trong hệ thống.
        </div>
      <% else %>
        <div class="dashboard-list">
          <%= for user <- @top_users do %>
            <a class="dashboard-list-item" href={~p"/songs/library?user_id=#{user.user_id}"}>
              <div class="dashboard-list-main">
                <div class="dashboard-list-title">{user.user_id}</div>
                <div class="dashboard-list-subtitle">
                  {user.total} bài • {user.completed} completed
                </div>
              </div>

              <span class="dashboard-badge">{user.total}</span>
            </a>
          <% end %>
        </div>
      <% end %>
    </article>
  </section>

  <section class="card dashboard-panel">
    <div class="section-head">
      <div class="section-copy">
        <h2>Bài hát gần đây</h2>
        <p class="muted">Từ đây có thể mở nhanh chi tiết từng bài hát.</p>
      </div>

      <a class="secondary-button" href={~p"/songs/library"}>
        Mở trang quản lý
      </a>
    </div>

    <%= if @songs_empty? do %>
      <div class="empty-state">
        Chưa có bài hát nào để hiển thị trên dashboard.
      </div>
    <% else %>
      <div class="dashboard-list">
        <%= for song <- @recent_songs do %>
          <a class="dashboard-list-item" href={~p"/songs/#{song.id}"}>
            <div class="dashboard-list-main">
              <div class="dashboard-list-title">{song.title || "AI - Untitled"}</div>
              <div class="dashboard-list-subtitle">
                {song.user_id} • {song.duration_sec} sec • {song.updated_at}
              </div>
            </div>

            <span class={"status-pill status-#{song.status}"}>
              {song.status}
            </span>
          </a>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
