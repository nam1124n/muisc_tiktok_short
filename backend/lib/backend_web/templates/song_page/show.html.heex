<div class="page-shell">
  <a class="back-link" href={@user_filter_path}>&larr; Quay lại danh sách theo user</a>

  <section class="hero hero-tonal">
    <div class="hero-actions">
      <div class="hero-copy">
        <h1>{@song.title || "AI - Untitled"}</h1>
        <p>
          Xem nhanh metadata, audio và các thao tác quản trị cho bài hát này.
        </p>
      </div>

      <div class="button-row">
        <a class="secondary-button hero-button" href={~p"/songs/#{@song.id}/edit"}>Chỉnh sửa</a>

        <form method="post" action={~p"/songs/#{@song.id}"} class="inline-form">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <input type="hidden" name="_method" value="delete" />
          <button
            class="danger-button hero-button"
            type="submit"
            onclick="return confirm('Xóa bài hát này?');"
          >
            Xóa bài hát
          </button>
        </form>
      </div>
    </div>
  </section>

  <section class="detail-grid detail-grid-wide">
    <article class="card detail-card">
      <h2>Thông tin chính</h2>

      <div class="meta-list">
        <div class="meta-row">
          <p class="meta-label">ID</p>
          <p class="meta-value mono">{@song.id}</p>
        </div>

        <div class="meta-row">
          <p class="meta-label">User ID</p>
          <p class="meta-value">
            <a href={@user_filter_path}>{@song.user_id}</a>
          </p>
        </div>

        <div class="meta-row">
          <p class="meta-label">Trạng thái</p>
          <p class="meta-value">
            <span class={"status-pill status-#{@song.status}"}>
              {@song.status}
            </span>
          </p>
        </div>

        <div class="meta-row">
          <p class="meta-label">Thời lượng</p>
          <p class="meta-value">{@song.duration_sec} sec</p>
        </div>

        <div class="meta-row">
          <p class="meta-label">Created At</p>
          <p class="meta-value mono">{@song.created_at}</p>
        </div>

        <div class="meta-row">
          <p class="meta-label">Updated At</p>
          <p class="meta-value mono">{@song.updated_at}</p>
        </div>
      </div>
    </article>

    <article class="card detail-card">
      <h2>Prompt</h2>
      <div class="prompt-box">{@song.prompt}</div>

      <h2 class="section-spacer">Audio Preview</h2>
      <%= if @song.audio_url do %>
        <audio controls preload="none">
          <source src={@song.audio_url} type="audio/mpeg" />
        </audio>
        <p class="muted mono section-caption">{@song.audio_url}</p>
      <% else %>
        <div class="empty-state">
          Chưa có audio cho bài hát này.
        </div>
      <% end %>
    </article>
  </section>
</div>
