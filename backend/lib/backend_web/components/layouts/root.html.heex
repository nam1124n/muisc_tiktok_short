<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title] || "AI Music Backend"}</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #eef3fb;
        --bg-soft: #f7f9fc;
        --panel: #ffffff;
        --panel-soft: #f7faff;
        --panel-muted: #eef3fb;
        --line: #dde5f0;
        --line-strong: #c9d4e5;
        --text: #142033;
        --muted: #5e6b80;
        --accent: #1a73e8;
        --accent-strong: #0b57d0;
        --accent-soft: #e8f0fe;
        --accent-soft-strong: #d2e3fc;
        --ok: #137333;
        --ok-soft: #dff3e5;
        --warn: #b06000;
        --warn-soft: #ffefcc;
        --danger: #c5221f;
        --danger-soft: #fce8e6;
        --shadow-1: 0 1px 2px rgba(15, 23, 42, 0.05), 0 12px 32px rgba(15, 23, 42, 0.06);
        --shadow-2: 0 24px 56px rgba(17, 51, 101, 0.2);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(26, 115, 232, 0.12), transparent 28%),
          radial-gradient(circle at top right, rgba(11, 87, 208, 0.1), transparent 24%),
          linear-gradient(180deg, #f8fbff 0%, var(--bg) 100%);
        color: var(--text);
        font-family: "Roboto", "Segoe UI Variable Text", "Segoe UI", sans-serif;
        letter-spacing: 0.01em;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      .page-shell {
        max-width: 1440px;
        margin: 0 auto;
        padding: 28px 32px 56px;
      }

      .hero {
        margin-bottom: 24px;
        padding: 28px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 28px;
        background: linear-gradient(135deg, #113365 0%, #0b57d0 54%, #4785ff 100%);
        box-shadow: var(--shadow-2);
        color: #ffffff;
      }

      .hero h1 {
        margin: 0;
        font-size: clamp(28px, 3vw, 40px);
        line-height: 1.1;
        font-weight: 700;
        letter-spacing: -0.03em;
      }

      .hero p {
        margin: 0;
        max-width: 720px;
        font-size: 15px;
        line-height: 1.65;
        color: rgba(255, 255, 255, 0.88);
      }

      .hero-tonal {
        background: linear-gradient(180deg, #ffffff 0%, #f6f9ff 100%);
        border-color: var(--line);
        box-shadow: var(--shadow-1);
        color: var(--text);
      }

      .hero-tonal p {
        color: var(--muted);
      }

      .hero-copy {
        display: grid;
        gap: 10px;
        max-width: 860px;
      }

      .toolbar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 22px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        min-height: 36px;
        padding: 0 14px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.14);
        color: #ffffff;
        font-size: 13px;
        font-weight: 500;
      }

      .stat-grid,
      .detail-grid {
        display: grid;
        gap: 18px;
        margin-bottom: 24px;
      }

      .stat-grid {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      }

      .stat-grid-wide {
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      }

      .detail-grid {
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      }

      .detail-grid-wide {
        grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
      }

      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 24px;
        box-shadow: var(--shadow-1);
      }

      .card h2,
      .card h3 {
        margin: 0;
        font-size: 16px;
        line-height: 1.3;
        letter-spacing: -0.01em;
      }

      .stat-value {
        font-size: 36px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.04em;
        margin: 0;
      }

      .stat-label,
      .muted {
        color: var(--muted);
      }

      .stat-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .stat-card {
        display: grid;
        gap: 14px;
        min-height: 122px;
        padding: 20px 22px;
        background: linear-gradient(180deg, #ffffff 0%, var(--panel-soft) 100%);
      }

      .dashboard-grid {
        display: grid;
        gap: 20px;
        grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
        margin-bottom: 24px;
      }

      .dashboard-panel {
        min-height: 100%;
      }

      .filter-card,
      .dashboard-panel,
      .user-section,
      .side-panel,
      .group-stack,
      .section-copy,
      .hero-copy {
        min-width: 0;
      }

      .quick-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: minmax(0, 1fr);
      }

      .quick-card {
        display: grid;
        gap: 10px;
        padding: 20px;
        border: 1px solid var(--line);
        border-radius: 22px;
        background: linear-gradient(180deg, #ffffff 0%, var(--panel-soft) 100%);
        color: var(--text);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease,
          border-color 0.18s ease;
      }

      .quick-card:hover {
        transform: translateY(-1px);
        border-color: var(--accent-soft-strong);
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
      }

      .quick-card-kicker {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .quick-card h3 {
        margin: 0;
        font-size: 18px;
      }

      .quick-card p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.55;
      }

      .dashboard-list {
        display: grid;
        gap: 12px;
      }

      .dashboard-list-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 16px 18px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--panel-soft);
        color: var(--text);
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease,
          border-color 0.18s ease,
          background 0.18s ease;
      }

      .dashboard-list-item:hover {
        transform: translateY(-1px);
        background: #ffffff;
        border-color: var(--line-strong);
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
      }

      .dashboard-list-main {
        min-width: 0;
        display: grid;
        gap: 4px;
      }

      .dashboard-list-title {
        font-weight: 700;
        line-height: 1.4;
      }

      .dashboard-list-subtitle {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.5;
      }

      .dashboard-badge {
        display: inline-flex;
        min-width: 32px;
        height: 32px;
        align-items: center;
        justify-content: center;
        padding: 0 10px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.92);
        color: var(--accent-strong);
        font-size: 13px;
        font-weight: 700;
      }

      .table-wrap {
        overflow: auto;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: var(--panel);
      }

      table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
      }

      .song-table {
        min-width: 1040px;
      }

      th,
      td {
        padding: 16px;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
        text-align: left;
      }

      th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--panel-soft);
        color: var(--muted);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      tbody tr:hover {
        background: #fbfdff;
      }

      tbody tr:last-child td {
        border-bottom: none;
      }

      .mono {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 12px;
        line-height: 1.5;
      }

      .notice-stack {
        max-width: 1440px;
        margin: 16px auto 0;
        padding: 0 32px;
      }

      .notice {
        padding: 14px 18px;
        border-radius: 18px;
        border: 1px solid var(--line);
        margin-bottom: 12px;
        box-shadow: var(--shadow-1);
      }

      .notice-info {
        background: #eff6ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
      }

      .notice-error {
        background: #fef2f2;
        color: #b91c1c;
        border-color: #fecaca;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.01em;
      }

      .status-processing {
        color: var(--warn);
        background: var(--warn-soft);
      }

      .status-completed {
        color: var(--ok);
        background: var(--ok-soft);
      }

      .empty-state {
        padding: 32px;
        border: 1px dashed var(--line);
        border-radius: 20px;
        background: var(--panel-soft);
        color: var(--muted);
      }

      .meta-list {
        display: grid;
        gap: 0;
      }

      .meta-row {
        display: grid;
        gap: 4px;
        padding: 16px 0;
        border-bottom: 1px solid var(--line);
      }

      .meta-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      .meta-label {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .meta-value {
        margin: 0;
        line-height: 1.6;
      }

      .prompt-box {
        padding: 20px 22px;
        border-radius: 20px;
        background: var(--panel-soft);
        border: 1px solid var(--line);
        white-space: pre-wrap;
      }

      audio {
        margin-top: 4px;
        width: 100%;
        min-width: 220px;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.76);
        color: var(--muted);
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      }

      .back-link:hover {
        background: #ffffff;
      }

      .hero-actions,
      .section-head {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
      }

      .button-row {
        display: flex;
        gap: 10px;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
      }

      .section-head {
        margin-bottom: 18px;
      }

      .hero-button {
        align-self: flex-start;
      }

      .filter-form,
      .song-form {
        display: grid;
        gap: 24px;
      }

      .filter-form {
        grid-template-columns: minmax(0, 1.6fr) 220px auto;
        align-items: end;
      }

      .form-grid {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .field,
      .field-full {
        display: grid;
        gap: 10px;
      }

      .field-full {
        grid-column: 1 / -1;
      }

      label {
        font-size: 13px;
        font-weight: 600;
        color: #314155;
        letter-spacing: 0.01em;
      }

      input,
      select,
      textarea,
      button {
        font: inherit;
      }

      input,
      select,
      textarea {
        width: 100%;
        min-height: 56px;
        padding: 16px;
        border-radius: 16px;
        border: 1px solid var(--line);
        background: var(--panel-soft);
        color: var(--text);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease;
      }

      textarea {
        resize: vertical;
        min-height: 140px;
      }

      input:focus,
      select:focus,
      textarea:focus {
        outline: none;
        background: #ffffff;
        border-color: rgba(26, 115, 232, 0.45);
        box-shadow: 0 0 0 4px rgba(26, 115, 232, 0.14);
      }

      .field-error {
        margin: 0;
        color: var(--danger);
        font-size: 13px;
      }

      .filter-note,
      .section-caption {
        margin-bottom: 0;
      }

      .filter-note {
        margin-top: 18px;
        padding: 12px 14px;
        border-radius: 16px;
        background: var(--panel-soft);
        font-size: 14px;
        line-height: 1.5;
      }

      .section-caption {
        margin-top: 12px;
        font-size: 12px;
        line-height: 1.5;
      }

      .primary-button,
      .secondary-button,
      .neutral-button,
      .danger-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0 18px;
        border-radius: 999px;
        border: 1px solid transparent;
        text-decoration: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease,
          background 0.18s ease,
          border-color 0.18s ease;
      }

      .primary-button:hover,
      .secondary-button:hover,
      .neutral-button:hover,
      .danger-button:hover {
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
      }

      .primary-button {
        background: var(--accent);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--accent-strong);
      }

      .secondary-button {
        background: var(--accent-soft);
        color: var(--accent-strong);
        border-color: var(--accent-soft-strong);
      }

      .neutral-button {
        background: #ffffff;
        color: var(--text);
        border-color: var(--line-strong);
      }

      .neutral-button:hover {
        background: var(--bg-soft);
      }

      .danger-button {
        background: var(--danger-soft);
        color: var(--danger);
        border-color: #f7c7c3;
      }

      .danger-button:hover {
        background: #f9ddda;
      }

      .button-row-tight {
        gap: 8px;
      }

      .inline-form {
        display: inline-flex;
        margin: 0;
      }

      .admin-grid {
        display: grid;
        gap: 24px;
        grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
        align-items: start;
      }

      .side-panel {
        position: sticky;
        top: 24px;
        padding: 24px;
        background: linear-gradient(180deg, #ffffff 0%, var(--panel-soft) 100%);
      }

      .user-list,
      .group-stack {
        display: grid;
        gap: 12px;
        min-width: 0;
      }

      .user-pill {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 12px;
        min-height: 56px;
        padding: 12px 14px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--panel-soft);
        color: var(--text);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease,
          border-color 0.18s ease,
          background 0.18s ease;
      }

      .user-pill.active {
        border-color: var(--accent-soft-strong);
        background: var(--accent-soft);
      }

      .user-pill:hover {
        text-decoration: none;
        background: #ffffff;
        border-color: var(--line-strong);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
        transform: translateY(-1px);
      }

      .user-pill-label {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 500;
      }

      .user-pill-count {
        display: inline-flex;
        min-width: 28px;
        height: 28px;
        align-items: center;
        justify-content: center;
        padding: 0 10px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.88);
        color: var(--accent-strong);
        font-size: 13px;
        font-weight: 700;
      }

      .table-title {
        font-size: 15px;
        font-weight: 700;
        line-height: 1.35;
        margin-bottom: 8px;
        overflow-wrap: anywhere;
      }

      .section-copy h2,
      .table-support {
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .table-support {
        color: var(--muted);
      }

      .prompt-preview {
        max-width: 360px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.55;
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
      }

      .song-cluster {
        display: grid;
        gap: 16px;
        min-width: 0;
      }

      .song-card {
        display: grid;
        gap: 18px;
        padding: 20px;
        border: 1px solid var(--line);
        border-radius: 22px;
        background: linear-gradient(180deg, #ffffff 0%, var(--panel-soft) 100%);
        min-width: 0;
      }

      .song-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .song-card-copy {
        display: grid;
        gap: 6px;
        min-width: 0;
      }

      .song-card-copy h3 {
        margin: 0;
        font-size: 20px;
        line-height: 1.35;
        overflow-wrap: anywhere;
      }

      .song-card-grid {
        display: grid;
        gap: 16px;
        grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(160px, 0.5fr));
        min-width: 0;
      }

      .song-card-block {
        display: grid;
        gap: 8px;
        min-width: 0;
      }

      .song-card-block-wide {
        min-width: 0;
      }

      .song-card-text {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        color: var(--text);
        overflow-wrap: anywhere;
      }

      .song-card-footer {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding-top: 16px;
        border-top: 1px solid var(--line);
      }

      .song-card-audio {
        display: grid;
        gap: 8px;
        min-width: 0;
      }

      .song-card-audio a {
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .song-card-actions {
        justify-content: flex-end;
        margin-left: auto;
      }

      .song-title-cell {
        min-width: 300px;
      }

      .song-prompt-cell {
        min-width: 280px;
      }

      .song-duration-cell,
      .song-status-cell,
      .song-updated-cell,
      .song-audio-cell,
      .song-actions-cell {
        white-space: nowrap;
      }

      .table-actions {
        flex-wrap: nowrap;
        justify-content: flex-end;
      }

      .error-card {
        border-color: #f7c7c3;
        background: linear-gradient(180deg, #ffffff 0%, #fff6f6 100%);
      }

      .error-list {
        margin: 0;
        padding-left: 18px;
        color: var(--danger);
        display: grid;
        gap: 6px;
      }

      .section-spacer {
        margin-top: 24px;
      }

      .section-copy {
        display: grid;
        gap: 4px;
      }

      .section-copy p,
      .section-summary {
        margin: 0;
        font-size: 14px;
        line-height: 1.5;
      }

      .detail-card {
        min-height: 100%;
      }

      @media (max-width: 1080px) {
        .dashboard-grid,
        .admin-grid,
        .detail-grid-wide {
          grid-template-columns: 1fr;
        }

        .side-panel {
          position: static;
        }
      }

      @media (max-width: 840px) {
        .hero h1 {
          font-size: 26px;
        }

        .page-shell {
          padding: 20px 16px 40px;
        }

        .notice-stack {
          padding-inline: 16px;
        }

        .quick-grid,
        .filter-form,
        .form-grid,
        .song-card-grid {
          grid-template-columns: 1fr;
        }

        .card,
        .hero {
          padding: 20px;
        }

        .table-actions {
          flex-wrap: wrap;
        }

        .song-table {
          min-width: 840px;
        }

        .song-card-footer,
        .song-card-head {
          align-items: stretch;
        }

        .song-card-actions {
          margin-left: 0;
          justify-content: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <div class="notice-stack">
      <div :if={Phoenix.Flash.get(@flash, :info)} class="notice notice-info">
        {Phoenix.Flash.get(@flash, :info)}
      </div>

      <div :if={Phoenix.Flash.get(@flash, :error)} class="notice notice-error">
        {Phoenix.Flash.get(@flash, :error)}
      </div>
    </div>

    {@inner_content}
  </body>
</html>
