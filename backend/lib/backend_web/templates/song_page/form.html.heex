<div class="page-shell">
  <a class="back-link" href={@back_path}>&larr; Quay lại</a>

  <section class="hero hero-tonal">
    <h1>{@form_title}</h1>
    <p>{@form_description}</p>
  </section>

  <section :if={map_size(@errors) > 0} class="card error-card">
    <h2>Biểu mẫu chưa hợp lệ</h2>
    <ul class="error-list">
      <li :for={{field, message} <- @errors}>{field}: {message}</li>
    </ul>
  </section>

  <section class="detail-grid detail-grid-wide">
    <article class="card detail-card">
      <h2>Thông tin bài hát</h2>

      <form method="post" action={@submit_path} class="song-form">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input :if={@song.id} type="hidden" name="_method" value="patch" />

        <div class="form-grid">
          <div class="field">
            <label for="song_user_id">User ID</label>
            <input
              id="song_user_id"
              name="song[user_id]"
              type="text"
              value={@song.user_id}
              placeholder="uid_001"
              required
            />
            <p :if={@errors[:user_id]} class="field-error">{@errors[:user_id]}</p>
          </div>

          <div class="field">
            <label for="song_title">Title</label>
            <input
              id="song_title"
              name="song[title]"
              type="text"
              value={@song.title}
              placeholder="Để trống nếu muốn sinh từ prompt"
            />
          </div>

          <div class="field field-full">
            <label for="song_prompt">Prompt</label>
            <textarea
              id="song_prompt"
              name="song[prompt]"
              rows="6"
              placeholder="Mô tả mood, nhạc cụ, không khí..."
              required
            >{@song.prompt}</textarea>
            <p :if={@errors[:prompt]} class="field-error">{@errors[:prompt]}</p>
          </div>

          <div class="field">
            <label for="song_duration_sec">Duration</label>
            <input
              id="song_duration_sec"
              name="song[duration_sec]"
              type="number"
              min="1"
              max="60"
              value={@song.duration_sec}
            />
          </div>

          <div class="field">
            <label for="song_status">Status</label>
            <select id="song_status" name="song[status]">
              <option
                :for={status <- @status_options}
                value={status}
                selected={@song.status == status}
              >
                {status}
              </option>
            </select>
            <p :if={@errors[:status]} class="field-error">{@errors[:status]}</p>
          </div>

          <div class="field field-full">
            <label for="song_audio_url">Audio URL</label>
            <input
              id="song_audio_url"
              name="song[audio_url]"
              type="url"
              value={@song.audio_url}
              placeholder="https://..."
            />
          </div>
        </div>

        <div class="button-row section-spacer">
          <button class="primary-button" type="submit">{@submit_label}</button>
          <a class="neutral-button" href={@back_path}>Hủy</a>
        </div>
      </form>
    </article>

    <article class="card detail-card">
      <h2>Gợi ý quản lý</h2>
      <div class="meta-list">
        <div class="meta-row">
          <p class="meta-label">User ownership</p>
          <p class="meta-value">
            Gán đúng `user_id` để khi lọc trong dashboard, toàn bộ bài của user đó nằm cùng một nhóm.
          </p>
        </div>

        <div class="meta-row">
          <p class="meta-label">Status</p>
          <p class="meta-value">
            Dùng `processing` cho bài đang chờ audio, `completed` cho bài đã nghe được.
          </p>
        </div>

        <div class="meta-row">
          <p class="meta-label">Audio URL</p>
          <p class="meta-value">
            Nếu có đường dẫn audio, trang chi tiết sẽ phát trực tiếp ngay.
          </p>
        </div>
      </div>
    </article>
  </section>
</div>
